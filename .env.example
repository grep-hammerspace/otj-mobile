EXPO_PUBLIC_API_URL=https://example.ts.net

# The backend's credential identity key — the public half of the Ed25519 key the API signs its
# encryption-key announcement with. The app pins this: the OneAdvanced username and password are
# encrypted to a key the server publishes, and an announcement that does not verify against this
# value makes the app refuse to submit rather than fall back to plaintext.
#
# Not a secret, but it must be the pair of the backend's CREDENTIAL_IDENTITY_SEED. Both halves are
# printed together by, in the otjServices repo:
#   java -cp target/app.jar com.github.grepHammerspace.crypto.IdentityKeyTool generate
EXPO_PUBLIC_CREDENTIAL_IDENTITY_KEY=replace-me-with-the-key-IdentityKeyTool-prints
