EXPO_PUBLIC_API_URL=https://example.ts.net

# Public half of the backend's CREDENTIAL_IDENTITY_SEED. Not secret, but they're a pair: in
# otjServices, `java -cp target/app.jar com.github.grepHammerspace.crypto.IdentityKeyTool generate`
# prints both.
EXPO_PUBLIC_CREDENTIAL_IDENTITY_KEY=replace-me-with-the-key-IdentityKeyTool-prints
